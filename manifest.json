{
  "manifest_version": 3,
  "name": "Dusk Reader",
  "version": "1.0.0",
  "description": "Dark mode for every website: recolors each CSS rule instead of just inverting the page. © 2026 AnhEmSoftware.",
  "author": "AnhEmSoftware",
  "homepage_url": "https://anhemsoftware.com",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Dusk Reader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle Dusk Reader"
    },
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle for the current site"
    }
  }
}
